<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Window backgrounds must be resource references: Android 9 and older read windowBackground with
    getResourceId(), so a literal colour there leaves the window with no background at all and
    dialogs draw over the screen behind them (#640, #617).
    -->
    <color name="window_background_dark">#292626</color>
    <color name="window_background_light">#FFFFFF</color>
    <color name="dialog_background_dark">#2E2D2D</color>
    <color name="dialog_background_light">#F7F7F7</color>
</resources>
