    <string name="settings_car_install_manually">手动安装说明</string>
    <string name="settings_car_install_help">更新已下载并校验。请从车机主页打开支持的文件管理器或安装工具，手动安装此 APK。\n%1$s</string>
    <string name="settings_car_install_private">已校验的 APK 位于应用私有目录，文件管理器无法打开。请在手机或电脑下载 APK，使用车机支持的方式安装。</string>
    <string name="settings_car_hotspot_title">热点操作说明</string>
    <string name="settings_car_wifi_title">Wi-Fi 操作说明</string>
    <string name="settings_car_bluetooth_title">蓝牙配对说明</string>
    <string name="settings_car_hotspot_help">请从车机主页打开热点并开启。在 XPlay 填写相同的热点名称和密码，再让 iPhone 连接此热点。完成后返回这里连接 CarPlay。</string>
    <string name="settings_car_wifi_help">请从车机主页打开 Wi-Fi，让车机和 iPhone 连接同一个网络，再返回 XPlay。</string>
    <string name="settings_car_bluetooth_help">请从车机主页进入蓝牙功能，与 iPhone 完成配对。iPhone 保持蓝牙和 Wi-Fi 开启，返回 XPlay 后选择已配对的 iPhone。</string>
