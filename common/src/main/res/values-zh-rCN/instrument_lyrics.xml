<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_instrument_title">仪表投放（实验性）</string>
    <string name="settings_instrument_description">在 P7 导航卡片显示歌词、歌曲信息或 iPhone 独立地图。歌词即时生效，启用地图视频需下次连接 CarPlay 生效。</string>
    <string name="settings_instrument_enable">启用仪表投放</string>
    <string name="settings_instrument_auto">自动启动已授权通道</string>
    <string name="settings_instrument_auto_desc">仅在 CarPlay 会话期间启动，不会自动弹出 ADB 授权请求。</string>
    <string name="settings_instrument_stopped">已停止</string>
    <string name="settings_instrument_wait_carplay">等待 CarPlay 连接</string>
    <string name="settings_instrument_authorizing">正在检查本机 ADB 授权…</string>
    <string name="settings_instrument_starting">正在启动仪表通道…</string>
    <string name="settings_instrument_submitting">正在提交仪表图片</string>
    <string name="settings_instrument_wait_card">等待原车仪表导航卡片</string>
    <string name="settings_instrument_unavailable">仪表接口不可用，请检查固件和权限</string>
    <string name="settings_instrument_restoring">正在释放通道并检查原车地图恢复…</string>
    <string name="settings_instrument_released">通道已释放，请查看仪表上的原车地图</string>
    <string name="settings_instrument_restore_unknown">原车地图恢复未确认，请检查仪表</string>
    <string name="settings_instrument_adb_required">请开启本机 ADB，并在调试弹窗中允许 XPlay</string>
    <string name="settings_instrument_shell_required">需要 UID 为 2000 的 ADB shell</string>
    <string name="settings_instrument_release_required">仪表投放需要签名的 XPlay 车机包</string>
    <string name="settings_instrument_start">授权并启动通道</string>
    <string name="settings_instrument_stop">停止投放并恢复原车地图</string>
    <string name="settings_instrument_permissions">需要 E28 Android 9、本机 ADB 授权及 shell 访问原车服务的权限。请在仪表选择导航卡片。无需 Root、定位或通知读取权限。</string>
    <string name="settings_instrument_content">显示内容</string>
    <string name="settings_instrument_lyrics">当前句和下一句歌词</string>
    <string name="settings_instrument_song">歌曲信息</string>
    <string name="settings_instrument_font">歌词字号</string>
    <string name="settings_instrument_cover">显示专辑封面</string>
    <string name="settings_instrument_live">立即应用于仪表投放。</string>
    <string name="settings_instrument_lane">隐藏原车车道提示</string>
    <string name="settings_instrument_lane_desc">可选。停止后恢复当前缓存状态；无缓存时等待原车后续更新。</string>
    <string name="settings_instrument_online">在线查询歌词</string>
    <string name="settings_instrument_online_desc">优先查询网易云音乐，未匹配时尝试 LRCLIB。发送歌名、歌手、专辑和时长。车机需要联网，缓存歌词可离线使用。</string>
    <string name="settings_instrument_rematch">重新匹配当前歌曲</string>
    <string name="settings_instrument_cache_clear">清除歌词缓存</string>
    <string name="settings_instrument_cache">歌词缓存（上限 50 MB）</string>
    <string name="settings_instrument_wait_song">等待歌曲信息</string>
    <string name="settings_instrument_searching">正在查询同步歌词…</string>
    <string name="settings_instrument_matched">已匹配同步歌词</string>
    <string name="settings_instrument_cached">正在使用缓存歌词</string>
    <string name="settings_instrument_offline">已关闭在线查询，且无缓存歌词</string>
    <string name="settings_instrument_network_error">歌词网络请求失败，将稍后重试</string>
    <string name="settings_instrument_wait_progress">等待可靠的播放进度</string>
    <string name="settings_instrument_intro">前奏</string>
    <string name="settings_instrument_no_lyrics">未找到匹配的同步歌词</string>
    <string name="settings_instrument_paused">已暂停</string>
    <string name="settings_instrument_delay">歌词延迟</string>
    <string name="settings_instrument_delay_desc">补偿 CarPlay 音频延迟，所有歌曲的歌词统一延后显示。范围 0–5000 毫秒，每步 50 毫秒。立即生效，无需重连。</string>
    <string name="settings_instrument_output">仪表投放内容</string>
    <string name="settings_instrument_map">地图</string>
    <string name="settings_instrument_map_desc">地图使用 iPhone 独立地图视频。选择地图或开启地图投放后，下次连接生效，请自行选择重连时机。歌词可即时切换。请先停止 OP 等其他仪表投放应用。</string>
    <string name="settings_instrument_wait_map">等待 iPhone 独立地图；若本次连接中才开启地图，请重连</string>
    <string name="settings_floating_lyrics_title">CarPlay 悬浮歌词</string>
    <string name="settings_floating_lyrics_enable">显示悬浮歌词</string>
    <string name="settings_floating_lyrics_desc">播放时显示同步歌词；未找到歌词时显示歌名和查询状态。无需悬浮窗权限，共用全局歌词延迟。</string>
    <string name="settings_floating_lyrics_next">显示下一句歌词</string>
    <string name="settings_floating_lyrics_lock">长按后拖动</string>
    <string name="settings_floating_lyrics_lock_desc">长按歌词面板后即可拖动。普通点击和滑动穿透到 CarPlay；关闭此项可直接拖动。</string>
    <string name="settings_floating_lyrics_opacity">背景不透明度</string>
    <string name="settings_floating_lyrics_x">横向位置</string>
    <string name="settings_floating_lyrics_y">纵向位置</string>
    <string name="settings_lyrics_and_instrument">歌词与仪表</string>
    <string name="settings_lyrics_and_instrument_desc">统一配置悬浮歌词、仪表投放和共用的歌词同步。</string>
    <string name="settings_lyrics_shared">歌词来源与同步</string>
    <string name="settings_floating_lyrics_animation">歌词切换动画</string>
    <string name="settings_floating_lyrics_animation_desc">下一句平滑上移、放大成为当前句，动画约 250 毫秒。立即生效；切歌、跳进度和拖动时直接刷新。</string>
</resources>
