    <string name="settings_instrument_delay">歌词延迟</string>
    <string name="settings_instrument_delay_desc">补偿 CarPlay 音频延迟，所有歌曲的歌词统一延后显示。范围 0–5000 毫秒，每步 50 毫秒。立即生效，无需重连。</string>
    <string name="settings_instrument_map">地图</string>
    <string name="settings_instrument_map_desc">使用 iPhone 独立地图视频。启用后，下次连接生效，请自行选择重连时机。请先停止 OP 等其他仪表投放应用。</string>
    <string name="settings_instrument_wait_map">等待 iPhone 独立地图；若本次连接中才开启地图，请重连</string>
    <string name="settings_floating_lyrics_title">CarPlay 悬浮歌词</string>
    <string name="settings_floating_lyrics_enable">显示悬浮歌词</string>
    <string name="settings_floating_lyrics_desc">播放时显示同步歌词；未找到歌词时显示歌名和查询状态。无需悬浮窗权限，共用全局歌词延迟。</string>
    <string name="settings_floating_lyrics_next">显示下一句歌词</string>
    <string name="settings_floating_lyrics_lock">长按后拖动</string>
    <string name="settings_floating_lyrics_lock_desc">长按歌词面板后即可拖动。普通点击和滑动穿透到 CarPlay；关闭此项可直接拖动。</string>
    <string name="settings_floating_lyrics_opacity">背景不透明度</string>
    <string name="settings_floating_lyrics_x">横向位置</string>
    <string name="settings_floating_lyrics_y">纵向位置</string>
    <string name="settings_lyrics_shared">歌词来源与同步</string>
    <string name="settings_floating_lyrics_animation">歌词切换动画</string>
    <string name="settings_floating_lyrics_animation_desc">下一句平滑上移、放大成为当前句，动画约 250 毫秒。立即生效；切歌、跳进度和拖动时直接刷新。</string>
    <string name="settings_lyrics_category">歌词</string>
    <string name="settings_lyrics_category_desc">配置 CarPlay 悬浮歌词、字号、切换动画、位置、来源、缓存和延迟。</string>
    <string name="settings_instrument_map_category">仪表地图</string>
    <string name="settings_instrument_map_category_desc">配置仪表地图投放、授权、自动启动、状态和恢复。</string>
    <string name="settings_lyrics_lead">提前切句</string>
    <string name="settings_lyrics_lead_desc">普通逐行歌词可提前 0–1500 毫秒显示下一句，每步 50 毫秒；默认 0 表示关闭。与音频延迟独立，不代表准确识别唱完时刻。立即生效。</string>
