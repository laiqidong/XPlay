    <string name="settings_instrument_submitting">Передавання зображень на прилади</string>
    <string name="settings_instrument_wait_card">Очікування штатної картки навігації</string>
    <string name="settings_instrument_unavailable">Інтерфейс недоступний; перевірте прошивку й дозволи</string>
    <string name="settings_instrument_restoring">Звільнення каналу та перевірка відновлення карти…</string>
    <string name="settings_instrument_released">Канал звільнено; перевірте штатну карту</string>
    <string name="settings_instrument_restore_unknown">Відновлення карти не підтверджено; перевірте прилади</string>
    <string name="settings_instrument_adb_required">Увімкніть локальний ADB і дозвольте XPlay у вікні налагодження</string>
    <string name="settings_instrument_shell_required">Потрібен ADB shell з UID 2000</string>
    <string name="settings_instrument_release_required">Потрібен підписаний автомобільний пакет XPlay</string>
    <string name="settings_instrument_start">Дозволити та запустити канал</string>
    <string name="settings_instrument_stop">Зупинити й відновити штатну карту</string>
    <string name="settings_instrument_permissions">Потрібні E28 Android 9, локальний ADB і доступ shell до служб виробника. Виберіть картку навігації. Root, геолокація та читання сповіщень не потрібні.</string>
    <string name="settings_instrument_font">Розмір тексту пісні</string>
    <string name="settings_instrument_live">Діє відразу.</string>
    <string name="settings_instrument_lane">Приховати штатні підказки смуг</string>
    <string name="settings_instrument_lane_desc">Необов’язково. Після зупинки відновлюється свіжий знімок або очікується оновлення авто.</string>
    <string name="settings_instrument_online">Шукати текст онлайн</string>
    <string name="settings_instrument_online_desc">Спочатку пошук у NetEase Music, потім у LRCLIB. Надсилає назву, виконавця, альбом і тривалість. Потрібен інтернет; кеш працює офлайн.</string>
    <string name="settings_instrument_rematch">Знову знайти поточну пісню</string>
    <string name="settings_instrument_cache_clear">Очистити кеш текстів</string>
    <string name="settings_instrument_cache">Кеш текстів (до 50 МБ)</string>
    <string name="settings_instrument_wait_song">Очікування відомостей про трек</string>
    <string name="settings_instrument_searching">Пошук синхронного тексту…</string>
    <string name="settings_instrument_matched">Синхронний текст знайдено</string>
    <string name="settings_instrument_cached">Використовується кешований текст</string>
    <string name="settings_instrument_offline">Онлайн-пошук вимкнено, кешу немає</string>
    <string name="settings_instrument_network_error">Помилка мережі; повтор пізніше</string>
    <string name="settings_instrument_wait_progress">Очікування достовірної позиції відтворення</string>
    <string name="settings_instrument_intro">...</string>
    <string name="settings_instrument_no_lyrics">Відповідного синхронного тексту немає</string>
    <string name="settings_instrument_delay">Затримка тексту</string>
    <string name="settings_instrument_delay_desc">Компенсує затримку звуку CarPlay для всіх пісень. Від 0 до 5000 мс із кроком 50 мс. Застосовується одразу без перепідключення.</string>
    <string name="settings_instrument_map">Карта</string>
    <string name="settings_instrument_map_desc">Використовує окремий відеопотік карти iPhone. Увімкнення діє з наступного підключення; виберіть час перепідключення. Зупиніть інші програми проєкції.</string>
    <string name="settings_instrument_wait_map">Очікування карти iPhone; перепідключіться, якщо ввімкнули її в цьому сеансі</string>
    <string name="settings_floating_lyrics_title">Плаваючий текст CarPlay</string>
    <string name="settings_floating_lyrics_enable">Показувати плаваючий текст</string>
    <string name="settings_floating_lyrics_desc">Під час відтворення показує синхронний текст або назву пісні та стан пошуку. Дозвіл накладання не потрібен. Використовує спільну затримку тексту.</string>
    <string name="settings_floating_lyrics_next">Показувати наступний рядок</string>
    <string name="settings_floating_lyrics_lock">Переміщення після утримання</string>
    <string name="settings_floating_lyrics_lock_desc">Утримуйте панель і переміщуйте. Звичайні дотики й жести проходять до CarPlay. Вимкніть для негайного переміщення.</string>
    <string name="settings_floating_lyrics_opacity">Непрозорість тла</string>
    <string name="settings_floating_lyrics_x">Горизонтальне положення</string>
    <string name="settings_floating_lyrics_y">Вертикальне положення</string>
    <string name="settings_lyrics_shared">Джерело та синхронізація тексту</string>
    <string name="settings_floating_lyrics_animation">Анімація зміни рядків</string>
    <string name="settings_floating_lyrics_animation_desc">Наступний рядок піднімається та збільшується за 250 мс. Діє відразу; при зміні пісні, перемотуванні та перетягуванні оновлюється без анімації.</string>
    <string name="settings_lyrics_category">Текст пісень</string>
    <string name="settings_lyrics_category_desc">Налаштування плаваючого тексту CarPlay, розміру, анімації, положення, джерел, кешу й затримки.</string>
    <string name="settings_instrument_map_category">Карта приладів</string>
    <string name="settings_instrument_map_category_desc">Налаштування карти приладів, авторизації, автозапуску, стану та відновлення.</string>
    <string name="settings_lyrics_lead">Раннє перемикання рядків</string>
    <string name="settings_lyrics_lead_desc">Показує рядок на 0–1500 мс раніше, крок 50 мс. Типово 0 — вимкнено. Незалежно від затримки аудіо; не визначає кінець співу. Діє відразу.</string>
    <string name="settings_lyrics_source_status">Джерело тексту · %1$s</string>
    <string name="settings_lyrics_netease">NetEase Music</string>
    <string name="settings_lyrics_unknown_source">Не записано</string>
</resources>
