    <string name="settings_instrument_cached">استخدام كلمات مخزنة</string>
    <string name="settings_instrument_offline">البحث عبر الإنترنت معطل ولا توجد كلمات مخزنة</string>
    <string name="settings_instrument_network_error">فشل طلب الشبكة؛ ستتم المحاولة لاحقًا</string>
