    <string name="settings_instrument_delay">تأخير الكلمات</string>
    <string name="settings_instrument_delay_desc">يعوض تأخر صوت CarPlay بتأخير كلمات جميع الأغاني. النطاق 0–5000 مللي ثانية بخطوات 50 مللي ثانية. يطبق فورًا دون إعادة الاتصال.</string>
    <string name="settings_instrument_map">الخريطة</string>
    <string name="settings_instrument_map_desc">يستخدم بث خريطة iPhone المستقلة. يسري التفعيل عند الاتصال التالي؛ اختر وقت إعادة الاتصال. أوقف تطبيقات العرض الأخرى أولاً.</string>
    <string name="settings_instrument_wait_map">بانتظار خريطة iPhone؛ أعد الاتصال إذا فعّلتها أثناء الجلسة</string>
    <string name="settings_floating_lyrics_title">كلمات عائمة في CarPlay</string>
    <string name="settings_floating_lyrics_enable">عرض الكلمات العائمة</string>
    <string name="settings_floating_lyrics_desc">يعرض الكلمات المتزامنة أثناء التشغيل، أو عنوان الأغنية وحالة البحث عند عدم توفر الكلمات. لا يحتاج إذن النوافذ العائمة. يستخدم تأخير الكلمات العام المشترك.</string>
    <string name="settings_floating_lyrics_next">عرض السطر التالي</string>
    <string name="settings_floating_lyrics_lock">السحب بعد الضغط المطول</string>
    <string name="settings_floating_lyrics_lock_desc">اضغط مطولًا على لوحة الكلمات ثم اسحب. تمر النقرات والسحبات العادية إلى CarPlay. عطّل الخيار للسحب مباشرة.</string>
    <string name="settings_floating_lyrics_opacity">عتامة الخلفية</string>
    <string name="settings_floating_lyrics_x">الموضع الأفقي</string>
    <string name="settings_floating_lyrics_y">الموضع العمودي</string>
    <string name="settings_lyrics_shared">مصدر الكلمات والمزامنة</string>
    <string name="settings_floating_lyrics_animation">حركة انتقال الكلمات</string>
    <string name="settings_floating_lyrics_animation_desc">يرتفع السطر التالي ويتكبر ليصبح السطر الحالي خلال 250 مللي ثانية. يطبق فوراً؛ يتحدث مباشرة عند تغيير الأغنية أو الانتقال أو السحب.</string>
    <string name="settings_lyrics_category">كلمات الأغاني</string>
    <string name="settings_lyrics_category_desc">إعداد كلمات CarPlay العائمة وحجم الخط والحركة والموضع والمصادر والتخزين والتأخير.</string>
    <string name="settings_instrument_map_category">خريطة العدادات</string>
    <string name="settings_instrument_map_category_desc">إعداد عرض خريطة العدادات والتفويض والبدء التلقائي والحالة والاستعادة.</string>
    <string name="settings_lyrics_lead">تقديم انتقال الكلمات</string>
    <string name="settings_lyrics_lead_desc">يعرض السطر التالي مبكراً بمقدار 0–1500 مللي ثانية بخطوات 50. القيمة 0 توقفه. مستقل عن تأخير الصوت ولا يحدد نهاية الغناء. يطبق فوراً.</string>
