<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_instrument_title">Карта приборной панели (экспериментально)</string>
    <string name="settings_instrument_description">Показывает отдельную карту iPhone в навигационной карточке P7. Включение действует со следующего подключения CarPlay.</string>
    <string name="settings_instrument_enable">Включить карту приборов</string>
    <string name="settings_instrument_auto">Автозапуск разрешённого канала</string>
    <string name="settings_instrument_auto_desc">Только при подключённом CarPlay; запрос доступа ADB автоматически не открывается.</string>
    <string name="settings_instrument_stopped">Остановлено</string>
    <string name="settings_instrument_wait_carplay">Ожидание CarPlay</string>
    <string name="settings_instrument_authorizing">Проверка доступа к локальному ADB…</string>
    <string name="settings_instrument_starting">Запуск канала приборов…</string>
    <string name="settings_instrument_submitting">Передача изображений на приборы</string>
    <string name="settings_instrument_wait_card">Ожидание штатной карточки навигации</string>
    <string name="settings_instrument_unavailable">Интерфейс недоступен; проверьте прошивку и разрешения</string>
    <string name="settings_instrument_restoring">Освобождение канала и проверка восстановления карты…</string>
    <string name="settings_instrument_released">Канал освобождён; проверьте штатную карту</string>
    <string name="settings_instrument_restore_unknown">Восстановление карты не подтверждено; проверьте приборы</string>
    <string name="settings_instrument_adb_required">Включите локальный ADB и разрешите XPlay в окне отладки</string>
    <string name="settings_instrument_shell_required">Нужен ADB shell с UID 2000</string>
    <string name="settings_instrument_release_required">Нужен подписанный автомобильный пакет XPlay</string>
    <string name="settings_instrument_start">Разрешить и запустить канал</string>
    <string name="settings_instrument_stop">Остановить и восстановить штатную карту</string>
    <string name="settings_instrument_permissions">Нужны E28 Android 9, доступ к локальному ADB и службам производителя через shell. Выберите карточку навигации. Root, геолокация и чтение уведомлений не нужны.</string>
    <string name="settings_instrument_font">Размер текста песни</string>
    <string name="settings_instrument_live">Действует сразу.</string>
    <string name="settings_instrument_lane">Скрыть штатные подсказки полос</string>
    <string name="settings_instrument_lane_desc">Необязательно. При остановке восстанавливается свежий снимок или ожидается обновление автомобиля.</string>
    <string name="settings_instrument_online">Искать текст в интернете</string>
    <string name="settings_instrument_online_desc">Поиск по порядку: NetEase Music, QQ Music, Kugou, LRCLIB. Отправляются название, исполнитель, альбом и длительность. Нужен интернет; кэш работает офлайн.</string>
    <string name="settings_instrument_rematch">Повторно найти текущую песню</string>
    <string name="settings_instrument_cache_clear">Очистить кэш текстов</string>
    <string name="settings_instrument_cache">Кэш текстов (до 50 МБ)</string>
    <string name="settings_instrument_wait_song">Ожидание сведений о треке</string>
    <string name="settings_instrument_searching">Поиск синхронного текста…</string>
    <string name="settings_instrument_matched">Синхронный текст найден</string>
    <string name="settings_instrument_cached">Используется текст из кэша</string>
    <string name="settings_instrument_offline">Поиск в сети отключён, кэша нет</string>
    <string name="settings_instrument_network_error">Ошибка сети; повтор позже</string>
    <string name="settings_instrument_wait_progress">Ожидание достоверной позиции воспроизведения</string>
    <string name="settings_instrument_intro">...</string>
    <string name="settings_instrument_no_lyrics">Подходящий синхронный текст не найден</string>
    <string name="settings_instrument_delay">Задержка текста</string>
    <string name="settings_instrument_delay_desc">Компенсирует задержку звука CarPlay для всех песен. От 0 до 5000 мс с шагом 50 мс. Применяется сразу без переподключения.</string>
    <string name="settings_instrument_map">Карта</string>
    <string name="settings_instrument_map_desc">Использует отдельный видеопоток карты iPhone. Включение действует со следующего подключения; выберите время переподключения. Остановите другие приложения проекции.</string>
    <string name="settings_instrument_wait_map">Ожидание карты iPhone; переподключитесь, если включили её в этом сеансе</string>
    <string name="settings_floating_lyrics_title">Плавающий текст CarPlay</string>
    <string name="settings_floating_lyrics_enable">Показывать плавающий текст</string>
    <string name="settings_floating_lyrics_desc">При воспроизведении показывает синхронный текст или название песни и статус поиска. Разрешение наложения не нужно. Используется общая задержка текста.</string>
    <string name="settings_floating_lyrics_next">Показывать следующую строку</string>
    <string name="settings_floating_lyrics_lock">Перемещение после удержания</string>
    <string name="settings_floating_lyrics_lock_desc">Удерживайте панель, затем перемещайте. Обычные касания и жесты проходят в CarPlay. Отключите для немедленного перемещения.</string>
    <string name="settings_floating_lyrics_opacity">Непрозрачность фона</string>
    <string name="settings_floating_lyrics_x">Положение по горизонтали</string>
    <string name="settings_floating_lyrics_y">Положение по вертикали</string>
    <string name="settings_lyrics_shared">Источник и синхронизация текста</string>
    <string name="settings_floating_lyrics_animation">Анимация смены строк</string>
    <string name="settings_floating_lyrics_animation_desc">Следующая строка поднимается и увеличивается за 250 мс. Действует сразу; при смене песни, перемотке и перетаскивании обновляется без анимации.</string>
    <string name="settings_lyrics_category">Текст песен</string>
    <string name="settings_lyrics_category_desc">Настройка плавающего текста CarPlay, размера, анимации, положения, источников, кэша и задержки.</string>
    <string name="settings_instrument_map_category">Карта приборов</string>
    <string name="settings_instrument_map_category_desc">Настройка карты приборов, авторизации, автозапуска, состояния и восстановления.</string>
    <string name="settings_lyrics_lead">Раннее переключение строк</string>
    <string name="settings_lyrics_lead_desc">Показывает строку на 0–1500 мс раньше, шаг 50 мс. По умолчанию 0 — выключено. Независимо от задержки аудио; не определяет конец пения. Действует сразу.</string>
    <string name="settings_lyrics_source_status">Источник текста · %1$s</string>
    <string name="settings_lyrics_netease">NetEase Music</string>
    <string name="settings_lyrics_unknown_source">Не записан</string>
    <string name="settings_lyrics_qqmusic">QQ Music</string>
    <string name="settings_lyrics_kugou">Kugou</string>
</resources>
