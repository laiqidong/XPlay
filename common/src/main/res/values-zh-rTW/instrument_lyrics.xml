    <string name="settings_instrument_font">歌詞字級</string>
    <string name="settings_instrument_live">立即生效。</string>
    <string name="settings_instrument_lane">隱藏原車車道提示</string>
    <string name="settings_instrument_lane_desc">選用。停止後復原目前快取狀態；沒有快取時等待原車後續更新。</string>
    <string name="settings_instrument_online">線上查詢歌詞</string>
    <string name="settings_instrument_online_desc">依序查詢網易雲音樂、QQ 音樂、酷狗和 LRCLIB，未比對或失敗時自動嘗試下一來源。傳送歌名、歌手、專輯與時長。車機需要連網，快取歌詞可離線使用。</string>
    <string name="settings_instrument_rematch">重新比對目前歌曲</string>
    <string name="settings_instrument_cache_clear">清除歌詞快取</string>
    <string name="settings_instrument_cache">歌詞快取（上限 50 MB）</string>
    <string name="settings_instrument_wait_song">等待歌曲資訊</string>
    <string name="settings_instrument_searching">正在查詢同步歌詞…</string>
    <string name="settings_instrument_matched">已比對同步歌詞</string>
    <string name="settings_instrument_cached">正在使用快取歌詞</string>
    <string name="settings_instrument_offline">已關閉線上查詢，且無快取歌詞</string>
    <string name="settings_instrument_network_error">歌詞網路要求失敗，稍後重試</string>
    <string name="settings_instrument_wait_progress">等待可靠的播放進度</string>
    <string name="settings_instrument_intro">...</string>
    <string name="settings_instrument_no_lyrics">找不到相符的同步歌詞</string>
    <string name="settings_instrument_delay">歌詞延遲</string>
    <string name="settings_instrument_delay_desc">補償 CarPlay 音訊延遲，所有歌曲的歌詞統一延後顯示。範圍 0–5000 毫秒，每次 50 毫秒。立即生效，無需重新連線。</string>
    <string name="settings_instrument_map">地圖</string>
    <string name="settings_instrument_map_desc">使用 iPhone 獨立地圖串流。啟用後，下次連線生效，請自行選擇重新連線時機。請先停止其他儀表投放應用程式。</string>
    <string name="settings_instrument_wait_map">等待 iPhone 獨立地圖；若本次連線才啟用地圖，請重新連線</string>
    <string name="settings_floating_lyrics_title">CarPlay 懸浮歌詞</string>
    <string name="settings_floating_lyrics_enable">顯示懸浮歌詞</string>
    <string name="settings_floating_lyrics_desc">播放時顯示同步歌詞；找不到歌詞時顯示歌名與查詢狀態。無需懸浮視窗權限，共用全域歌詞延遲。</string>
    <string name="settings_floating_lyrics_next">顯示下一句歌詞</string>
    <string name="settings_floating_lyrics_lock">長按後拖曳</string>
    <string name="settings_floating_lyrics_lock_desc">長按歌詞面板後即可拖曳。一般點按和滑動穿透至 CarPlay；關閉此項可直接拖曳。</string>
    <string name="settings_floating_lyrics_opacity">背景不透明度</string>
    <string name="settings_floating_lyrics_x">水平位置</string>
    <string name="settings_floating_lyrics_y">垂直位置</string>
    <string name="settings_lyrics_shared">歌詞來源與同步</string>
    <string name="settings_floating_lyrics_animation">歌詞切換動畫</string>
    <string name="settings_floating_lyrics_animation_desc">下一句平滑上移、放大成為目前句，動畫約 250 毫秒。立即生效；切歌、跳轉進度與拖曳時直接更新。</string>
    <string name="settings_lyrics_category">歌詞</string>
    <string name="settings_lyrics_category_desc">設定 CarPlay 懸浮歌詞、字級、切換動畫、位置、來源、快取與延遲。</string>
    <string name="settings_instrument_map_category">儀表地圖</string>
    <string name="settings_instrument_map_category_desc">設定儀表地圖投放、授權、自動啟動、狀態與還原。</string>
    <string name="settings_lyrics_lead">提前切句</string>
    <string name="settings_lyrics_lead_desc">逐行歌詞可提前 0–1500 毫秒顯示下一句，每步 50 毫秒；預設 0 表示關閉。與音訊延遲獨立，不代表準確識別唱完時刻。立即生效。</string>
